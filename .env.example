# Copy to .env and fill in your own values. Never commit the filled-in .env.
# Create a free "script" app at https://www.reddit.com/prefs/apps to get these.

REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USERNAME=your_reddit_username
# Optional - built from REDDIT_USERNAME when left unset.
REDDIT_USER_AGENT=EngineeringStudents Scraper v1.0 by /u/your_reddit_username

# Optional overrides
TARGET_SUBREDDIT=EngineeringStudents
DEFAULT_LIMIT=500
DEFAULT_BATCH_SIZE=50
RATE_LIMIT_DELAY=0.2
MAX_COMMENT_DEPTH=10

RAW_DATA_DIR=data/raw
CLEAN_DATA_DIR=data/clean
LOG_DIR=logs
MAX_OUTPUT_FILE_SIZE=209715200
MAX_OUTPUT_WORDS=500000
